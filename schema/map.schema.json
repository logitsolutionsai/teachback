{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/logitsolutionsai/teachback/schema/map.schema.json",
  "title": "teachback map.json",
  "description": "The concept map: concepts with prerequisites, forming a directed acyclic graph.",
  "type": "object",
  "required": ["schema", "concepts"],
  "properties": {
    "schema": { "const": "teachback/map@1" },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "required": ["id", "name", "summary", "sources", "prerequisites"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1, "description": "One paragraph in your own words." },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section"],
            "additionalProperties": false,
            "properties": {
              "section": { "type": "string", "minLength": 1, "description": "Section, figure, table or equation in the source, such as \"3.2.1\" or \"Table 1\"." },
              "label": { "type": "string" },
              "page": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "pInit": { "type": "number", "minimum": 0, "maximum": 1 },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
