{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/logitsolutionsai/teachback/schema/items.schema.json",
  "title": "teachback items.json",
  "description": "The question bank. Each item practises one concept.",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": { "const": "teachback/items@1" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "concept", "type", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "concept": { "type": "string", "minLength": 1 },
        "type": { "enum": ["mcq", "numeric", "short", "teachback", "code"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "prompt": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "description": "Section of the source this item draws on." },
        "options": {
          "type": "array",
          "description": "mcq only. Every option carries a rationale shown after the learner answers.",
          "items": {
            "type": "object",
            "required": ["text", "rationale"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string" }
            }
          }
        },
        "answer": {
          "type": "number",
          "description": "mcq: 0-based index of the correct option. numeric: the expected value."
        },
        "tolerance": { "type": "number", "minimum": 0, "description": "numeric only. Absolute tolerance." },
        "unit": { "type": "string" },
        "explanation": { "type": "string" },
        "rubric": { "$ref": "#/$defs/rubric" },
        "modelAnswer": { "type": "string", "description": "short and teachback: a good answer in plain words, for the tutor." },
        "exercise": { "type": "string", "description": "code only. The exercise id." },
        "pSlip": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "pGuess": { "type": "number", "minimum": 0, "maximum": 0.9 }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "idea", "synonyms"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "idea": { "type": "string", "minLength": 1 },
              "synonyms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "polarity": { "enum": ["positive", "negative"], "description": "negative: the idea is a negative statement, so a negation next to a match is expected and not flagged" }
            }
          }
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "synonyms"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "synonyms": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "polarity": { "enum": ["positive", "negative"], "description": "negative: the idea is a negative statement, so a negation next to a match is expected and not flagged" }
            }
          }
        },
        "minRequired": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
