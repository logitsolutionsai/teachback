{
  "name": "teachback",
  "version": "0.1.0",
  "description": "Learn a research paper with a Socratic tutor that finishes when you can teach it back and rebuild it. A Claude Code skill (agent skill) for Claude Code, Codex and Cursor.",
  "type": "module",
  "license": "MIT",
  "author": "Logit Solutions AI",
  "homepage": "https://github.com/logitsolutionsai/teachback",
  "repository": {
    "type": "git",
    "url": "https://github.com/logitsolutionsai/teachback.git"
  },
  "bin": {
    "teachback": "scripts/teachback.mjs"
  },
  "files": [
    "scripts/",
    "src/",
    "schema/",
    "references/",
    "examples/",
    "SKILL.md",
    ".claude-plugin/"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.mjs\"",
    "check:examples": "node scripts/teachback.mjs check examples/attention-is-all-you-need && node scripts/teachback.mjs check examples/bloom-filters"
  },
  "keywords": [
    "claude-code",
    "claude-skill",
    "claude-code-skill",
    "agent-skills",
    "agent-skill",
    "codex",
    "cursor",
    "tutor",
    "socratic",
    "socratic-method",
    "spaced-repetition",
    "knowledge-tracing",
    "mastery-learning",
    "research-papers",
    "papers",
    "learning",
    "teach-back"
  ],
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
